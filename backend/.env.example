# Copy this file to .env and fill in real values. NEVER commit .env.
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Phase 2 - Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SPREADSHEET_ID=

# Phase 5 - Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Phase 10 - Facebook Messenger
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# Phase 11 - WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Phase 14 - Security
# Shared secret required in the "X-API-Key" header for every owner-only
# endpoint (/dashboard/*, /learning/*, /follow-up/*, /test/message).
# REQUIRED before exposing this server to the internet — until this is
# set, those endpoints are unprotected (a loud warning is logged on every
# call so this is impossible to miss).
OWNER_API_KEY=
# Max requests per minute per caller IP for public webhook endpoints and
# /test/message. Single-process in-memory limiter (no paid service needed).
RATE_LIMIT_PER_MINUTE=60
